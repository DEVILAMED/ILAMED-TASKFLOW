generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String               @id @default(uuid())
  name              String?
  email             String               @unique
  password          String?
  role              UserRole             @default(USER)
  isBlocked         Boolean              @default(false)
  avatar            String?
  lastSeenAt        DateTime?
  createdAt         DateTime             @default(now())
  comments          Comment[]
  activities        Activity[]
  memberships       Membership[]
  projects          Project[]
  sessions          Session[]
  tasks             Task[]               @relation("AssignedTasks")
  statusChanges     TaskStatusHistory[]  @relation("TaskStatusActor")
  submissions       TaskSubmission[]     @relation("TaskSubmitter")
  reviews           TaskReview[]         @relation("TaskReviewer")
  employeeProfile   EmployeeProfile?
  managedEmployees  EmployeeProfile[]    @relation("ReportingManager")
  headedDepartments Department[]         @relation("DepartmentHead")
  todoLists         TodoList[]           @relation("TodoListOwner")
  todoMemberships   TodoListMembership[]
  createdTodoTasks  TodoTask[]           @relation("TodoTaskCreator")
  todoMyDayEntries  TodoMyDayEntry[]
  inboxList         TodoList?            @relation("TodoInboxOwner")
  teamsCreated      Team[]               @relation("TeamCreator")
  teamMemberships   TeamMembership[]
  notifications     Notification[]       @relation("NotificationRecipient")
  sentNotifications Notification[]       @relation("NotificationActor")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  headId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  head        User?             @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees   EmployeeProfile[]

  @@index([headId])
}

model EmployeeProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  employeeCode     String?          @unique
  phone            String?
  designation      String?
  joiningDate      DateTime?        @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  departmentId     String?
  managerId        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager          User?            @relation("ReportingManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([departmentId, employmentStatus])
  @@index([managerId])
}

model Project {
  id            String         @id @default(uuid())
  title         String
  description   String?
  createdAt     DateTime       @default(now())
  ownerId       String
  teamId        String?
  members       Membership[]
  owner         User           @relation(fields: [ownerId], references: [id])
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sprints       Sprint[]
  tasks         Task[]
  activities    Activity[]
  notifications Notification[]

  @@index([teamId])
}

model Task {
  id             String                     @id @default(uuid())
  title          String
  description    String?
  issueType      IssueType                  @default(TASK)
  status         TaskStatus                 @default(TODO)
  priority       Priority                   @default(MEDIUM)
  storyPoints    Int?
  dueDate        DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  projectId      String
  assigneeId     String?
  sprintId       String?
  comments       Comment[]
  assignee       User?                      @relation("AssignedTasks", fields: [assigneeId], references: [id])
  project        Project                    @relation(fields: [projectId], references: [id])
  sprint         Sprint?                    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  checklistItems CompanyTaskChecklistItem[]
  labels         TaskLabel[]
  activities     Activity[]
  notifications  Notification[]
  statusHistory  TaskStatusHistory[]
  submissions    TaskSubmission[]
}

model CompanyTaskChecklistItem {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  position    Int
  createdAt   DateTime @default(now())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model TaskStatusHistory {
  id         String      @id @default(uuid())
  taskId     String
  actorId    String
  fromStatus TaskStatus?
  toStatus   TaskStatus
  createdAt  DateTime    @default(now())
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor      User        @relation("TaskStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}

model TaskSubmission {
  id            String       @id @default(uuid())
  taskId        String
  submittedById String
  notes         String?
  createdAt     DateTime     @default(now())
  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy   User         @relation("TaskSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviews       TaskReview[]

  @@index([taskId, createdAt])
  @@index([submittedById, createdAt])
}

model TaskReview {
  id           String         @id @default(uuid())
  submissionId String
  reviewerId   String
  decision     ReviewDecision
  rating       Int?
  feedback     String
  createdAt    DateTime       @default(now())
  submission   TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     User           @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([reviewerId, createdAt])
}

model Sprint {
  id                String                   @id @default(uuid())
  title             String
  goal              String?
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean                  @default(false)
  completedAt       DateTime?
  scopeTasks        Int?
  scopePoints       Int?
  completedTasks    Int?
  carriedOverTasks  Int?
  completedPoints   Int?
  carriedOverPoints Int?
  createdAt         DateTime                 @default(now())
  projectId         String
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks             Task[]
  snapshots         SprintProgressSnapshot[]
}

model SprintProgressSnapshot {
  id              String   @id @default(uuid())
  sprintId        String
  snapshotDate    DateTime @db.Date
  scopeTasks      Int
  scopePoints     Int
  remainingTasks  Int
  remainingPoints Int
  sprint          Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, snapshotDate])
}

model Activity {
  id        String       @id @default(uuid())
  type      ActivityType
  message   String
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  href      String
  createdAt DateTime         @default(now())
  readAt    DateTime?
  userId    String
  actorId   String?
  projectId String?
  taskId    String?
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

model Label {
  id    String      @id @default(uuid())
  name  String
  color String?
  tasks TaskLabel[]
}

model TaskLabel {
  taskId  String
  labelId String
  label   Label  @relation(fields: [labelId], references: [id])
  task    Task   @relation(fields: [taskId], references: [id])

  @@id([taskId, labelId])
}

model Membership {
  id        String  @id @default(uuid())
  role      Role    @default(MEMBER)
  userId    String
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, projectId])
}

model Team {
  id          String           @id @default(uuid())
  name        String
  createdAt   DateTime         @default(now())
  createdById String
  createdBy   User             @relation("TeamCreator", fields: [createdById], references: [id])
  memberships TeamMembership[]
  projects    Project[]

  @@index([createdById])
}

model TeamMembership {
  id        String   @id @default(uuid())
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  teamId    String
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, role])
}

model TodoList {
  id           String               @id @default(uuid())
  name         String
  isInbox      Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  ownerId      String
  inboxOwnerId String?              @unique
  owner        User                 @relation("TodoListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inboxOwner   User?                @relation("TodoInboxOwner", fields: [inboxOwnerId], references: [id], onDelete: Cascade)
  memberships  TodoListMembership[]
  tasks        TodoTask[]

  @@index([ownerId])
}

model TodoListMembership {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  listId    String
  userId    String
  list      TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
}

model TodoTask {
  id           String           @id @default(uuid())
  title        String
  note         String?
  isCompleted  Boolean          @default(false)
  important    Boolean          @default(false)
  dueDate      DateTime?
  reminderAt   DateTime?
  repeat       TodoRepeat?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  listId       String
  creatorId    String
  list         TodoList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator      User             @relation("TodoTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  steps        TodoTaskStep[]
  myDayEntries TodoMyDayEntry[]

  @@index([listId, dueDate])
  @@index([listId, isCompleted])
}

model TodoMyDayEntry {
  id        String   @id @default(uuid())
  date      DateTime
  createdAt DateTime @default(now())
  userId    String
  taskId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      TodoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, date])
  @@index([taskId])
}

model TodoTaskStep {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  taskId      String
  task        TodoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum TaskStatus {
  TODO
  ACCEPTED
  IN_PROGRESS
  ON_HOLD
  SUBMITTED_FOR_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  DONE
}

enum ReviewDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
}

enum Role {
  OWNER
  MEMBER
}

enum TeamRole {
  MANAGER
  MEMBER
}

enum UserRole {
  USER
  MANAGER
  ADMIN
}

enum TodoRepeat {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  TASK_COMMENTED
  SPRINT_CREATED
  SPRINT_COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_COMMENTED
  MENTIONED
  DUE_DATE_CHANGED
  TASK_SUBMITTED
  TASK_APPROVED
  TASK_REVISION_REQUESTED
  TASK_REJECTED
}
